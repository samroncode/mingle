# Copy this file to .env and fill in the values. Never commit .env.
# Hosting and every secret name used online: docs/hosting.md.
#
# Vite bundles every VITE_ variable into the public JavaScript, so only
# browser-safe values may have that prefix. The Supabase service-role/secret
# key and the AI provider's API key must never get a VITE_ prefix; they belong in
# supabase/functions/.env for the Edge Functions.

# Supabase dashboard → Project Settings → API keys.
# Use the publishable key (sb_publishable_…) or the legacy anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (Cloudflare dashboard → Turnstile). It is
# public, like the Supabase publishable key. Set it only for live; with it
# empty (local, staging, tests) sign-in asks for no CAPTCHA. The secret key
# goes in the Supabase dashboard (Auth → CAPTCHA), never here.
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Edge Functions (server side). Not read by the app, and never VITE_ prefixed.
#
# Locally: put these in supabase/functions/.env (git-ignored); `supabase
# functions serve` loads it. In the hosted project: `supabase secrets set`.
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into every function by the platform (and by the local stack), so they are not
# set here. The service-role key bypasses RLS: it must never reach the browser.

# Comma-separated origins allowed to call host-actions (CORS),
# e.g. http://localhost:5173,https://mingle.vercel.app
# `npm run test:db` doesn't read this: it serves the functions with its own
# test env file (supabase/tests/functions-setup.ts).
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Hosting (names only, never values here). Full steps: docs/hosting.md.
#
# Vercel environment variables (browser-safe only):
#   Production: VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY, VITE_TURNSTILE_SITE_KEY
#   Preview:    VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY
#
# GitHub Actions secrets:
#   SUPABASE_ACCESS_TOKEN
#   SUPABASE_LIVE_PROJECT_REF
#   SUPABASE_LIVE_DB_PASSWORD
#   SUPABASE_STAGING_PROJECT_REF
#   SUPABASE_STAGING_DB_PASSWORD
#   VERCEL_DEPLOY_HOOK_URL
#   LIVE_SUPABASE_URL
#   LIVE_SUPABASE_PUBLISHABLE_KEY
#   STAGING_SUPABASE_URL
#   STAGING_SUPABASE_PUBLISHABLE_KEY
#
# Supabase dashboard (not env vars): the Turnstile secret key goes in
# Auth → Attack Protection → CAPTCHA.
