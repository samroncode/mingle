# Copy this file to .env and fill in the values. Never commit .env.
#
# Vite bundles every VITE_ variable into the public JavaScript, so only
# browser-safe values may have that prefix. The Supabase service-role/secret
# key and the AI provider's API key must never get a VITE_ prefix; they belong in
# supabase/functions/.env for the Edge Functions.

# Supabase dashboard → Project Settings → API keys.
# Use the publishable key (sb_publishable_…) or the legacy anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
